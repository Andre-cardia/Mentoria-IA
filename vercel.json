{
  "installCommand": "npm install --engine-strict=false",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://neuralhub.ia.br/neuralhub.html", "permanent": false},
    {"source": "/identidade-neuralhub/inicio.html", "missing": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://neuralhub.ia.br/neuralhub.html", "permanent": false},
    {"source": "/neuralhub-compartilhado.html", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "/neuralhub.html", "permanent": false},
    {"source": "/plataforma.html", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://mentoria.neuralhub.ia.br/plataforma", "permanent": false},
    {"source": "/plataforma/:path*", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://mentoria.neuralhub.ia.br/plataforma/:path*", "permanent": false},
    {"source": "/solicitar-proposta", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://mentoria.neuralhub.ia.br/solicitar-proposta", "permanent": false},
    {"source": "/blog/:path*", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://mentoria.neuralhub.ia.br/blog/:path*", "permanent": false},
    {"source": "/aulas/governanca-ia/:path*", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://mentoria.neuralhub.ia.br/aulas/governanca-ia/:path*", "permanent": false},
    {"source": "/governanca-ia/:path*", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "https://mentoria.neuralhub.ia.br/governanca-ia/:path*", "permanent": false}
  ],
  "rewrites": [
    {"source": "/aulao", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "/aulao/index.html"},
    {"source": "/aulao/obrigado", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "/aulao/obrigado.html"},
    {"source": "/zero-to-hero", "destination": "/zero-to-hero/index.html"},
    {"source": "/auditoria", "destination": "/auditoria.html"},
    {"source": "/auditoria/(.*)", "destination": "/auditoria.html"},
    {"source": "/privacidade", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "/privacidade.html"},
    {"source": "/termos", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "/termos.html"},
    {"source": "/obrigado", "destination": "/obrigado.html"},
    {"source": "/lead", "destination": "/lead.html"},
    {"source": "/brand", "destination": "/brand.html"},
    {"source": "/(.*)", "has": [{"type": "host", "value": "neuralhub.ia.br"}], "destination": "/identidade-neuralhub/inicio.html"},
    {"source": "/neuralhub.html", "destination": "/neuralhub-compartilhado.html"},
    {"source": "/neuralhub", "destination": "/neuralhub-compartilhado.html"},
    {"source": "/neuralhub/(.*)", "destination": "/neuralhub-compartilhado.html"},
    {"source": "/solicitar-proposta", "destination": "/index.html"},
    {"source": "/governanca-ia", "destination": "/index.html"},
    {"source": "/governanca-ia/(.*)", "destination": "/index.html"},
    {"source": "/aulas/governanca-ia", "destination": "/index.html"},
    {"source": "/aulas/governanca-ia/(.*)", "destination": "/index.html"},
    {"source": "/gestao", "destination": "/gestao.html"},
    {"source": "/gestao/(.*)", "destination": "/gestao.html"},
    {"source": "/plataforma", "destination": "/plataforma.html"},
    {"source": "/plataforma/(.*)", "destination": "/plataforma.html"},
    {"source": "/blog", "destination": "/index.html"},
    {"source": "/blog/(.*)", "destination": "/index.html"}
  ]
}
